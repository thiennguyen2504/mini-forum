# --- Tùy chọn 1: Kết nối PostgreSQL chạy qua Docker Compose (hoặc local PostgreSQL trên máy host) ---
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/mini_blog

# --- Tùy chọn 2: Kết nối PostgreSQL khi ứng dụng FastAPI cũng chạy bên trong Docker Container ---
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/mini_blog

# --- Tùy chọn 3: Kết nối PostgreSQL với URL tuỳ chỉnh / Cloud Database (Supabase, ElephantSQL, RDS, v.v.) ---
# DATABASE_URL=postgresql+psycopg2://username:password@hostname:5432/dbname

# --- Tùy chọn 4: Kết nối SQLite sử dụng file cục bộ (Không cần cài đặt PostgreSQL) ---
# DATABASE_URL=sqlite:///./mini_blog.db

SECRET_KEY=your-super-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Cấu hình Redis Cache ---
REDIS_URL=redis://localhost:6379/0
# Khi chạy trong Docker Compose:
# REDIS_URL=redis://redis:6379/0

# --- Cấu hình Kafka Event Stream ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Khi chạy trong Docker Compose:
# KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# --- Cấu hình AI Microservice (Gemini API & Structured Output) ---
# API key cho Google Gemini (để trống nếu dùng LLM_PROVIDER=fake)
GEMINI_API_KEY=
# Tên mô hình Gemini (mặc định gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
# Mức độ lọc an toàn của Gemini: BLOCK_NONE, BLOCK_ONLY_HIGH, BLOCK_MEDIUM_AND_ABOVE, BLOCK_LOW_AND_ABOVE
GEMINI_SAFETY_LEVEL=BLOCK_ONLY_HIGH
# Nhà cung cấp LLM: 'gemini' (gọi Google Gemini API) hoặc 'fake' (chạy offline không tốn phí)
LLM_PROVIDER=gemini
# Thời gian timeout tối đa cho mỗi lượt gọi Gemini (giây)
LLM_TIMEOUT_SECONDS=20
# Số lần retry tối đa khi LLM trả lỗi (JSON hỏng, schema sai, timeout, 429/5xx)
LLM_MAX_RETRIES=2
# Thời gian lưu cache phân tích bài viết trên Redis (giây, mặc định 6 giờ)
AI_CACHE_TTL_SECONDS=21600
# Bắt buộc xác thực JWT khi gọi /ai/analyze (true/false)
AI_REQUIRE_AUTH=true
# Số lượng ký tự tối đa đầu vào gửi sang LLM (cắt ngắn nếu vượt quá)
AI_MAX_INPUT_CHARS=6000
# Phiên bản prompt áp dụng: 'v1' (baseline) hoặc 'v2' (cải tiến)
AI_PROMPT_VERSION=v2
# Địa chỉ URL của ai-service mà forum-service sẽ kết nối tới
AI_SERVICE_URL=http://localhost:8000
# Khi chạy trong Docker Compose (forum-service kết nối nội bộ):
# AI_SERVICE_URL=http://ai-service:8000

